DATABASE_URL=postgresql+psycopg://voiceorder:changeme@localhost/voiceorder
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3
OLLAMA_TIMEOUT=120
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_BEAM_SIZE=1
AUDIO_DIR=C:/voiceorder/audio
DEFAULT_PHONE_REGION=LB
EXPECTED_LANGUAGES=["en","ar"]

# Bill delivery (POST /bills/request). Leave SMTP_PASSWORD out of chat/VCS -
# fill it in only in your local .env. Until it's set, bill requests still
# render the bill but report it as undelivered instead of sending it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Voice Order Intake <you@gmail.com>
BILL_RECIPIENT_EMAIL=anis.w.matta@gmail.com
