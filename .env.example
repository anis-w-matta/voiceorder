DATABASE_URL=postgresql+psycopg://voiceorder:changeme@localhost/voiceorder
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Salesman login tokens (app/services/auth.py) - generate your own, never
# share this value across deployments:
#   python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
AUDIO_DIR=C:/voiceorder/audio
DEFAULT_PHONE_REGION=LB
EXPECTED_LANGUAGES=["en","ar"]
# IANA zone for resolving spoken calendar-day references ("yesterday's
# order") to a UTC instant range - see app/services/prior_order.py.
BUSINESS_TIMEZONE=Asia/Beirut

# Item resolver thresholds - see app/services/item_resolver.py
FUZZY_ALIAS_THRESHOLD=80
RESOLVER_TIE_EPSILON=0.02
ATTRIBUTE_CONFLICT_PENALTY=0.35

# Gemini call reliability - retry/backoff (app/services/gemini_retry.py) and
# a conservative rate limit (app/services/rate_limiter.py) so the worker
# never runs at 100% of the free-tier quota. Raise GEMINI_RPM_LIMIT only if
# your account's actual quota (check in AI Studio) is higher.
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BASE_SECONDS=1.0
GEMINI_RETRY_MAX_SECONDS=8.0
GEMINI_RPM_LIMIT=10
GEMINI_MAX_CONCURRENT=1

# Transcription quality/retry - app/services/transcript_quality.py
MAX_TRANSCRIPTION_ATTEMPTS=2
TRANSCRIPT_MIN_CHARS_PER_SECOND=0.6
TRANSCRIPT_REPETITION_THRESHOLD=0.5
TRANSCRIPT_DISAGREEMENT_EDIT_THRESHOLD=0.55
TRANSCRIPT_DISAGREEMENT_TOKEN_OVERLAP_MIN=0.5
