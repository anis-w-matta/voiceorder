DATABASE_URL=mssql+pyodbc://voiceorder:changeme@localhost/voiceorder?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Salesman login tokens (app/services/auth.py) - generate your own, never
# share this value across deployments:
#   python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
# Defaults to <repo>/audio if unset - only set this to store recordings
# somewhere else.
#AUDIO_DIR=/path/to/audio
DEFAULT_PHONE_REGION=LB
EXPECTED_LANGUAGES=["en","ar"]

# catalog-service (item/customer/order_header/order_details/qra_header/
# qra_detail) - see app/services/catalog_client.py and the sibling
# vendo-app/catalog-service repo. CATALOG_API_KEY must match that
# service's own API_KEY setting.
CATALOG_SERVICE_URL=http://127.0.0.1:8100
CATALOG_API_KEY=

# Gemini call reliability - retry/backoff (app/services/gemini_retry.py) and
# a rate limit (app/services/rate_limiter.py) shared by transcription and
# command extraction (gemini_command_extractor.py) - two calls per voice
# message now, not one. Check your account's actual quota in AI Studio and
# adjust GEMINI_RPM_LIMIT if needed.
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BASE_SECONDS=1.0
GEMINI_RETRY_MAX_SECONDS=8.0
GEMINI_RPM_LIMIT=20
GEMINI_MAX_CONCURRENT=1

# Transcription quality/retry - app/services/transcript_quality.py
MAX_TRANSCRIPTION_ATTEMPTS=2
TRANSCRIPT_MIN_CHARS_PER_SECOND=0.6
TRANSCRIPT_REPETITION_THRESHOLD=0.5
TRANSCRIPT_DISAGREEMENT_EDIT_THRESHOLD=0.55
TRANSCRIPT_DISAGREEMENT_TOKEN_OVERLAP_MIN=0.5
